{
  "name": "@workspace/sanity-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./upsert": "./src/upsert.ts",
    "./sync": "./src/sync.ts",
    "./reconcile": "./src/reconcile.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "reconcile": "tsx --env-file-if-exists=.env src/reconcile.ts",
    "seed-refs": "tsx --env-file-if-exists=.env src/seed-refs.ts"
  },
  "dependencies": {
    "@sanity/client": "catalog:",
    "@workspace/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "sanity": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
