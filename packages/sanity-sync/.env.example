# Copy to `packages/sanity-sync/.env`.
#
# This package reads THIS file and nothing else. It deliberately does not fall
# back to `apps/web/.env.local` or `apps/studio/.env` — the fork base's
# `cleanup-stale-sanity.ts` reached across into the web app's env file, which
# meant a studio-side script broke whenever the web app's env moved. Duplicate
# the two or three values here instead.
#
# Every value below is required. An empty string is treated as absent.

# ─── Sanity write target ─────────────────────────────────────────────────────
# Same project and dataset as the apps, but named without either app's prefix
# (no NEXT_PUBLIC_, no SANITY_STUDIO_) so there is no ambiguity about whose
# env file is in play.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# sanity.io/manage → API → Tokens. Needs Editor or above: the sweep patches
# documents and reads existing ids. A read-only token is not enough.
SANITY_API_WRITE_TOKEN=sk-your-write-token

# Optional — dataset API version. Defaults to 2024-10-01.
# SANITY_API_VERSION=2024-10-01

# ─── BigCommerce Admin REST ──────────────────────────────────────────────────
# The reconcile sweep runs against the Admin REST catalog, not the Storefront
# GraphQL API: it needs `date_modified` filtering and invisible products, and
# neither is exposed to a storefront token. This is the same admin token the
# seed uses (apps/studio/.env), copied here rather than imported from there.
BIGCOMMERCE_STORE_HASH=your-store-hash
BIGCOMMERCE_ADMIN_TOKEN=your-admin-token
