{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract --enforce-required-fields --force",
    "check-types": "tsc --noEmit",
    "type": "sanity schema extract --enforce-required-fields --force && sanity typegen generate && pnpm --filter @workspace/sanity format",
    "seed:sanity": "tsx scripts/seed-sanity.ts",
    "seed:bigcommerce": "tsx scripts/seed-bigcommerce/index.ts",
    "sync:bigcommerce": "tsx --env-file-if-exists=../../packages/sanity-sync/.env ../../packages/sanity-sync/src/reconcile.ts --write"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/asset-utils": "^1.3.0",
    "@sanity/assist": "^6.1.17",
    "@sanity/client": "catalog:",
    "@sanity/functions": "^1.2.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/orderable-document-list": "^2.0.18",
    "@sanity/ui": "^3.5.2",
    "@sanity/uuid": "^3.0.2",
    "@sanity/vision": "^6.9.1",
    "@workspace/logger": "workspace:*",
    "@workspace/sanity-sync": "workspace:*",
    "dotenv": "^17.2.3",
    "friendlier-words": "^1.1.3",
    "lodash.get": "^4.4.2",
    "lucide-react": "catalog:",
    "pluralize-esm": "^9.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "^6.9.1",
    "sanity-plugin-asset-source-unsplash": "^7.0.21",
    "sanity-plugin-hotspot-array": "^5.0.12",
    "sanity-plugin-lucide-icon-picker": "^1.0.3",
    "sanity-plugin-media": "^6.1.1",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@sanity/blueprints": "0.10.0",
    "@types/lodash.get": "^4.4.7",
    "@types/react": "catalog:",
    "@types/styled-components": "^5.1.36",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "vite": "^7.3.1",
    "vite-plugin-tsconfig-paths": "^1.4.1"
  }
}
