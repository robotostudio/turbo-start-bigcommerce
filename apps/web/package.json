  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@workspace/typescript-config": "workspace:*",
    "baseline-browser-mapping": "^2.9.15",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
