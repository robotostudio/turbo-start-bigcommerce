    "@tanstack/react-query": "^5.104.5",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/sanity": "workspace:*",
    "@workspace/sanity-sync": "workspace:*",
    "@workspace/ui": "workspace:*",
