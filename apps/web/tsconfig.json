{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
    },
    "plugins": [
      {
        "name": "next",
      },
      // Editor-only: typed `graphql()` documents come from the committed
      // introspection type, so `tsc --noEmit` never needs this plugin, the
      // schema file, or a live store. `pnpm bigcommerce:schema` regenerates
      // both files below; both are committed.
      {
        "name": "@0no-co/graphqlsp",
        "schema": "./src/lib/bigcommerce/schema.graphql",
        "tadaOutputLocation": "./src/lib/bigcommerce/graphql-env.d.ts",
      },
    ],
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
  ],
  "exclude": ["node_modules"],
}
