# Copy to `apps/web/.env.local`, then replace the dummy values with real ones.
# The dummies below are shaped correctly and pass env validation as-is, so a
# fresh clone builds without any account anywhere.
#
# Validated by packages/env/src/{client,server}.ts. `KEY=` (empty) is treated as
# absent, so an optional var can be left blank or deleted — but a required one
# still has to carry a value.

# ─── Sanity ──────────────────────────────────────────────────────────────────
# From sanity.io/manage. Project ID accepts only [a-z0-9-] — @sanity/client
# rejects anything else at module load, which breaks the build.
NEXT_PUBLIC_SANITY_PROJECT_ID=abcd1234
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-29
# Must be an absolute URL — validated with z.url().
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# The same two values as NEXT_PUBLIC_SANITY_PROJECT_ID and _DATASET above, under
# the names @workspace/sanity-sync reads. The webhook receiver at
# /api/bigcommerce/webhook writes to Sanity through that package, and it reads
# process.env by these names on purpose — it owns its own env contract so that
# renaming a web var cannot break it silently. Keep the pairs in step.
SANITY_PROJECT_ID=abcd1234
SANITY_DATASET=production

# API tokens: sanity.io/manage → API → Tokens. Read powers draft previews;
# write is used by the studio seed/cleanup scripts (see apps/studio/.env.example)
# and by the webhook receiver.
SANITY_API_READ_TOKEN=dummy-sanity-read-token
SANITY_API_WRITE_TOKEN=dummy-sanity-write-token

# Shared with the Sanity webhook that drives /api/revalidate. Required, because
# it is what makes a publish reach a deployed site at all: `sanityFetch` caches
# with `revalidate: false`, so the `sanity` tag has to be invalidated by name and
# that route is the only thing that does it. Without it a deployment serves its
# build-time content for as long as it runs — never refreshed, not slowly
# refreshed.
#
# The dummy below builds and runs dev fine, since dev does not cache Sanity reads.
# Only a real webhook needs a real value: generate it with `openssl rand -hex 24`
# and paste the same string into the webhook's Secret field. See the README's
# revalidation section.
SANITY_REVALIDATE_SECRET=dummy-sanity-revalidate-secret

# ─── BigCommerce ─────────────────────────────────────────────────────────────
# Store hash: the ID in your store's API path,
# https://api.bigcommerce.com/stores/{store_hash}/v3/
BIGCOMMERCE_STORE_HASH=abc123def

# Must be a PRIVATE storefront token, not a vanilla one. Mint it with
# POST /v3/storefront/api-token with `"scopes": ["Unauthenticated","Customer"]`.
# Vanilla tokens are deliberately unsupported: server-to-server use is cut off
# 2027-03-31, and their CORS allowlist maxes out at 2 origins — one short of
# localhost + production + preview.
BIGCOMMERCE_STOREFRONT_TOKEN=dummy-private-storefront-token

# Admin REST token, a different token from the storefront one above and not
# interchangeable with it: /v3/hooks and /v3/catalog are both Admin-only. Mint
# it at Settings -> API accounts with the "Information & Settings" scope. Two
# things read it. The webhook receiver re-fetches the changed entity from
# /v3/catalog before writing to Sanity, and the hook-health check lists the
# store's webhooks with it. The same value lives in packages/sanity-sync/.env,
# which is where the sync scripts read it from.
BIGCOMMERCE_ADMIN_TOKEN=dummy-admin-token

# Shared with the nine registered webhooks, which send it as the
# x-bigcommerce-webhook-secret header. Generate with `openssl rand -hex 32` and
# pass the same string in each hook's `headers` object at registration time.
#
# This is the whole authentication story for /api/bigcommerce/webhook. The
# payload's own `hash` field is an unkeyed SHA-1 of the body — anyone who can
# reach the route can compute a valid one — so it is not and cannot be auth.
BIGCOMMERCE_WEBHOOK_SECRET=dummy-bigcommerce-webhook-secret

# The public URL the catalog webhooks are registered against. /api/bigcommerce/
# hook-health compares the store's hooks to this exact string, so it has to
# match what was sent to POST /v3/hooks, character for character (a trailing
# slash is forgiven, nothing else is). A dev tunnel's hooks live on the same
# store and cover the same scopes; this is what keeps them from being mistaken
# for production's.
BIGCOMMERCE_WEBHOOK_DESTINATION=https://your-site.example.com/api/bigcommerce/webhook

# Vercel sends `Authorization: Bearer ${CRON_SECRET}` with every cron
# invocation when this is set, and /api/bigcommerce/hook-health rejects
# anything else. Generate with `openssl rand -hex 24`. Required rather than
# optional: the alternative to a public endpoint is one that refuses every
# request, which is a monitor that never runs and never says so.
CRON_SECRET=dummy-cron-secret

# Optional — where a dead-hook alert lands. Any endpoint that accepts
# {"text": "..."}; a Slack incoming webhook is the assumed one. Leave it unset
# and the check still answers 500, which reddens the cron run in the Vercel
# dashboard — but nothing arrives anywhere a person is already looking.
# HOOK_HEALTH_ALERT_WEBHOOK_URL=

# Optional — defaults to 1, the default storefront channel.
BIGCOMMERCE_CHANNEL_ID=1

# Optional — how many catalog paths to prerender at build time. The rest render
# on demand, so this trades build time against first-visit latency, not coverage.
# Defaults to 100.
BIGCOMMERCE_PRERENDER_LIMIT=100

# Optional GraphQL endpoint override. Leave unset and it is derived as
# https://store-{BIGCOMMERCE_STORE_HASH}-{BIGCOMMERCE_CHANNEL_ID}.mybigcommerce.com/graphql
# BIGCOMMERCE_API_URL=

# ─── Storefront display ──────────────────────────────────────────────────────
# ISO 4217 code used to format prices (OG images, etc). Optional, defaults to GBP.
NEXT_PUBLIC_STORE_CURRENCY=GBP

# NEXT_PUBLIC_SITE_URL=https://example.com

# ─── Not listed on purpose ───────────────────────────────────────────────────
# NODE_ENV, NEXT_PUBLIC_VERCEL_ENV and VERCEL_ENV are enums. Absent is valid and
# falls back to a default; an empty or misspelled value is not. VERCEL_ENV in
# particular is validated by the t3-env `vercel()` preset, which runs before both
# the empty-string coercion and SKIP_ENV_VALIDATION — so `VERCEL_ENV=` fails the
# build outright and nothing can rescue it. Leave all three out.
#
# NEXT_PUBLIC_VERCEL_URL and NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL are
# injected by Vercel in production and preview, and default to localhost:3000
# otherwise. Set them only to override that locally.
#
# SKIP_ENV_VALIDATION=1 bypasses all validation. It belongs on the command line,
# not in this file.
