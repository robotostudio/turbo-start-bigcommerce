# Copy to `apps/web/.env.local`, then replace the dummy values with real ones.
# The dummies below are shaped correctly and pass env validation as-is, so a
# fresh clone builds without any account anywhere.
#
# Validated by packages/env/src/{client,server}.ts. `KEY=` (empty) is treated as
# absent, so an optional var can be left blank or deleted — but a required one
# still has to carry a value.

# ─── Sanity ──────────────────────────────────────────────────────────────────
# From sanity.io/manage. Project ID accepts only [a-z0-9-] — @sanity/client
# rejects anything else at module load, which breaks the build.
NEXT_PUBLIC_SANITY_PROJECT_ID=abcd1234
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-29
# Must be an absolute URL — validated with z.url().
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# API tokens: sanity.io/manage → API → Tokens. Read powers draft previews;
# write is used by the studio seed/cleanup scripts (see apps/studio/.env.example).
SANITY_API_READ_TOKEN=dummy-sanity-read-token
SANITY_API_WRITE_TOKEN=dummy-sanity-write-token

# ─── Shopify ─────────────────────────────────────────────────────────────────
# Still required until the BigCommerce flip lands — the build imports
# src/lib/shopify/client.ts, which reads all three.
SHOPIFY_STORE_DOMAIN=dummy-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=00000000000000000000000000000000
# Optional — defaults to 2025-01.
SHOPIFY_API_VERSION=2025-01

# ─── BigCommerce ─────────────────────────────────────────────────────────────
# Store hash: the ID in your store's API path,
# https://api.bigcommerce.com/stores/{store_hash}/v3/
BIGCOMMERCE_STORE_HASH=abc123def

# Must be a PRIVATE storefront token, not a vanilla one. Mint it with
# POST /v3/storefront/api-token with `"scopes": ["Unauthenticated","Customer"]`.
# Vanilla tokens are deliberately unsupported: server-to-server use is cut off
# 2027-03-31, and their CORS allowlist maxes out at 2 origins — one short of
# localhost + production + preview.
BIGCOMMERCE_STOREFRONT_TOKEN=dummy-private-storefront-token

# Optional — defaults to 1, the default storefront channel.
BIGCOMMERCE_CHANNEL_ID=1

# Optional GraphQL endpoint override. Leave unset and it is derived as
# https://store-{BIGCOMMERCE_STORE_HASH}-{BIGCOMMERCE_CHANNEL_ID}.mybigcommerce.com/graphql
# BIGCOMMERCE_API_URL=

# ─── Storefront display ──────────────────────────────────────────────────────
# ISO 4217 code used to format prices (OG images, etc). Optional, defaults to GBP.
NEXT_PUBLIC_STORE_CURRENCY=GBP

# ─── Not listed on purpose ───────────────────────────────────────────────────
# NODE_ENV, NEXT_PUBLIC_VERCEL_ENV and VERCEL_ENV are enums. Absent is valid and
# falls back to a default; an empty or misspelled value is not. VERCEL_ENV in
# particular is validated by the t3-env `vercel()` preset, which runs before both
# the empty-string coercion and SKIP_ENV_VALIDATION — so `VERCEL_ENV=` fails the
# build outright and nothing can rescue it. Leave all three out.
#
# NEXT_PUBLIC_VERCEL_URL and NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL are
# injected by Vercel in production and preview, and default to localhost:3000
# otherwise. Set them only to override that locally.
#
# SKIP_ENV_VALIDATION=1 bypasses all validation. It belongs on the command line,
# not in this file.
